        {
            "operation": "get_alert_updates",
            "title": "Get Alert Updates",
            "description": "Re-reads alerts that were already fetched from Falcora and reports which ones changed since, for example a new triage verdict, owner feedback, a different case or a new processing status. Use it to keep FortiSOAR alerts in sync with Falcora. Makes one request per alert.",
            "category": "investigation",
            "annotation": "get_alerts",
            "enabled": true,
            "parameters": [
                {
                    "title": "Tenant ID",
                    "type": "text",
                    "name": "tenant_id",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "ID of the Falcora tenant. Used for alerts whose stored data has no TenantId. Leave empty to use the Tenant ID from the connector configuration."
                },
                {
                    "title": "Alerts",
                    "type": "json",
                    "name": "alerts",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "List of the alerts to check, at most 200. Each entry can be a FortiSOAR alert record (its Source Data holds the previously fetched Falcora alert), a Falcora alert object, or a Falcora alert ID.",
                    "description": "List of the alerts to check, at most 200. Each entry can be a FortiSOAR alert record (its Source Data holds the previously fetched Falcora alert), a Falcora alert object, or a Falcora alert ID. A plain alert ID has nothing to compare against, so it is always reported as updated."
                }
            ],
