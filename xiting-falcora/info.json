{
    "name": "xiting-falcora",
    "version": "1.1.0",
    "label": "Xiting Falcora",
    "description": "Falcora is Xiting's security operations platform for SAP landscapes. It triages SAP security alerts with AI against customer SOPs, groups them into cases, collects system owner feedback and supports the analyst up to the final verdict. This connector ingests Falcora alerts into FortiSOAR and performs actions like reading alerts and cases, adding enrichment comments, assigning case processors and re-running the AI case analysis.",
    "publisher": "Fortinet CSE",
    "icon_small_name": "Bild.png",
    "icon_large_name": "Bild.png",
    "id": 86,
    "configuration": {
        "fields": [
            {
                "title": "Environment",
                "type": "select",
                "name": "environment",
                "required": true,
                "visible": true,
                "editable": true,
                "value": "Test",
                "tooltip": "Falcora environment to connect to. Test and Production set the API URL automatically. Select Custom to enter it yourself.",
                "options": [
                    "Test",
                    "Production",
                    "Custom"
                ],
                "onchange": {
                    "Custom": [
                        {
                            "title": "API URL",
                            "name": "api_url",
                            "type": "text",
                            "required": true,
                            "visible": true,
                            "editable": true,
                            "value": "https://api.falcora-test.xiting.com/backend/api",
                            "description": "Falcora API base URL including the /backend/api path prefix.",
                            "tooltip": "Falcora API base URL including the /backend/api path prefix."
                        }
                    ]
                }
            },
            {
                "title": "Tenant ID",
                "type": "text",
                "name": "tenant_id",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "ID of the Falcora tenant the connection credential was created for. A credential is valid for exactly one tenant. Shown in Falcora next to the credential."
            },
            {
                "title": "Username",
                "type": "text",
                "name": "username",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "Username of the Falcora connection credential (HTTP Basic authentication). Created by the Falcora administrator under Administration > Tenants > (tenant) > Technical Users."
            },
            {
                "title": "Password",
                "type": "password",
                "name": "password",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "Password of the Falcora connection credential. It is shown only once, at creation; if it is lost, rotate it in Falcora."
            },
            {
                "title": "Verify SSL",
                "type": "checkbox",
                "name": "verify_ssl",
                "required": false,
                "visible": true,
                "editable": true,
                "value": true,
                "tooltip": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is set to True."
            }
        ]
    },
    "operations": [
        {
            "operation": "get_alerts",
            "title": "Get Alerts",
            "description": "Retrieves a list of alerts from Falcora, newest first, based on the time range and filters you have specified. The time range applies to the time Falcora received the alert. Falcora does not page this list, so keep time ranges short.",
            "category": "investigation",
            "annotation": "get_alerts",
            "enabled": true,
            "parameters": [
                {
                    "title": "Tenant ID",
                    "type": "text",
                    "name": "tenant_id",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "ID of the Falcora tenant. Leave empty to use the Tenant ID from the connector configuration."
                },
                {
                    "title": "Relative Time Range",
                    "type": "select",
                    "name": "timestamp_relative",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Relative time range on the received time. Cannot be combined with Start Time or End Time.",
                    "options": [
                        "Last Hour",
                        "Last 24 Hours",
                        "Last 3 Days",
                        "Last 7 Days"
                    ]
                },
                {
                    "title": "Start Time",
                    "type": "datetime",
                    "name": "timestamp_from",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return records whose received time is at or after this time (inclusive)."
                },
                {
                    "title": "End Time",
                    "type": "datetime",
                    "name": "timestamp_to",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return records whose received time is before this time (exclusive)."
                },
                {
                    "title": "Case ID",
                    "type": "text",
                    "name": "case_id",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return only alerts linked to this case."
                },
                {
                    "title": "System ID",
                    "type": "text",
                    "name": "system_id",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return only alerts for this SAP system ID (exact match)."
                },
                {
                    "title": "Processing Status",
                    "type": "select",
                    "name": "processing_status",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return only alerts in this processing status.",
                    "options": [
                        "Open",
                        "Triage In Progress",
                        "Waiting For Owner Input",
                        "Blocked Quota Exceeded",
                        "Completed",
                        "Error"
                    ]
                },
                {
                    "title": "Triage",
                    "type": "select",
                    "name": "triage",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return only alerts with this AI triage verdict.",
                    "options": [
                        "False Positive",
                        "True Positive"
                    ]
                },
                {
                    "title": "System Owner ID",
                    "type": "text",
                    "name": "system_owner_id",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return only alerts routed to this system owner (Falcora user object ID)."
                },
                {
                    "title": "Alert Type",
                    "type": "select",
                    "name": "alert_type",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Return only alerts of this source type.",
                    "options": [
                        "Xiting SIEM Connector",
                        "SAP ETD",
                        "Splunk",
                        "Unknown"
                    ]
                },
                {
                    "title": "Include Details",
                    "type": "checkbox",
                    "name": "include_details",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": false,
                    "tooltip": "Select to read every returned alert individually, adding the raw event (AlertData), the triage justification, SOP and owner feedback. This makes one extra request per alert."
                },
                {
                    "title": "Limit",
                    "type": "integer",
                    "name": "limit",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Maximum number of alerts to return (applied after retrieval; newest first)."
                }
            ],
            "output_schema": [
                {
                    "TenantId": "",
                    "AlertId": "",
                    "AlertType": "",
                    "ReceivedAt": "",
                    "ProcessingStatus": "",
                    "ProcessingStatusString": "",
                    "LLMTriage": "",
                    "LLMTriageString": "",
                    "LLMFalsePositiveScore": "",
                    "LLMTriageEvaluatedAt": "",
                    "PatternName": "",
                    "SystemId": "",
                    "SystemOwnerIds": [],
                    "SystemOwnerClassification": "",
                    "SystemOwnerFeedbackReceivedAt": "",
                    "CaseId": "",
                    "CaseLinkageReason": "",
                    "UserIds": [],
                    "SourceIPAddress": "",
                    "UserAgent": "",
                    "TriageFlags": [],
                    "AlertSemanticDescription": "",
                    "SOP": {
                        "TenantId": "",
                        "SOPId": "",
                        "Version": ""
                    },
                    "CreatedBy": "",
                    "ChangedBy": ""
                }
            ],
            "open": false
        },
